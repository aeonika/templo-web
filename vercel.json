{
 "rewrites": [
  {
   "source": "/sitio/:slug",
   "destination": "/sitio.html?s=:slug"
  },
  {
   "source": "/s/:slug",
   "destination": "/sitio.html?s=:slug"
  },
  {
   "source": "/curso/:slug/:curso",
   "destination": "/curso.html?s=:slug&c=:curso"
  },
  {
   "source": "/producto/:slug/:producto",
   "destination": "/producto.html?s=:slug&p=:producto"
  }
 ]
}
